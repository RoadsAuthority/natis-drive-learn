PORT=3001
FRONTEND_ORIGIN=http://localhost:8080
# Quote the URL if it contains & (e.g. Neon channel_binding)
DATABASE_URL=""
# Required. Generate a unique value with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Used only for one-time initial admin setup. Never expose this to the frontend.
# Generate a separate value using the same command and remove it after setup.
ADMIN_SETUP_KEY=

